# MySQL을 사용할 때 아래 값을 설정하세요. 설정하지 않으면 로컬 H2 메모리 DB로 실행됩니다.
DB_URL=jdbc:mysql://localhost:3306/jeonse
DB_USERNAME=root
DB_PASSWORD=change-me

# Naver CLOVA OCR. 비워 두면 OCR API는 422로 실패하고 화면은 직접 답하기로 진행합니다.
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
# 회원 JWT 서명 키 (32바이트 이상 무작위 문자열). 비우면 로컬 개발용 임시 키를 만들고 재시작 때 로그인이 풀립니다.
JWT_SECRET=

# 진단 결과 쉬운 말 설명 (Claude). 비워 두면 템플릿 문장을 씁니다 (aiUsed: false).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
